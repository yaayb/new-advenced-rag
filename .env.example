# Copy to .env. Defaults work without any API key or LLM server.
EVIDENCELAB_VECTOR_BACKEND=qdrant

# --- Answer generation (LLM) ---
# "extractive" = no model (returns best sentences). "openai" = any OpenAI-compatible API.
EVIDENCELAB_LLM_BACKEND=extractive
# Free-tier presets (create a free key on the provider's site, never commit it):
#  Groq        base=https://api.groq.com/openai/v1                          model=llama-3.3-70b-versatile
#  OpenRouter  base=https://openrouter.ai/api/v1                             model=<any model ending in :free>
#  Gemini      base=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-2.5-flash
#  Ollama      base=http://host.docker.internal:11434/v1                     model=llama3.2  (key: any)
EVIDENCELAB_LLM_BASE_URL=https://api.groq.com/openai/v1
EVIDENCELAB_LLM_MODEL=llama-3.3-70b-versatile
EVIDENCELAB_LLM_API_KEY=

# --- Dense retrieval embeddings ---
# "hash" = offline baseline. "openai" = neural embeddings from an OpenAI-compatible /embeddings API
# (Gemini free tier works: key from https://aistudio.google.com). Re-index documents after switching.
EVIDENCELAB_EMBEDDING_BACKEND=hash
EVIDENCELAB_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EVIDENCELAB_EMBEDDING_MODEL=gemini-embedding-001
EVIDENCELAB_EMBEDDING_API_KEY=

# --- Production (docker-compose.prod.yml) ---
# Public domain pointing to your server (DNS A record); Caddy gets the HTTPS certificate.
DOMAIN=rag.example.com
# Required in production. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVIDENCELAB_API_KEY=

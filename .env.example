# Copy to .env. Defaults work without any LLM server.
EVIDENCELAB_VECTOR_BACKEND=qdrant
EVIDENCELAB_LLM_BACKEND=extractive
EVIDENCELAB_LLM_BASE_URL=http://host.docker.internal:11434/v1
EVIDENCELAB_LLM_MODEL=llama3.2

# --- Production (docker-compose.prod.yml) ---
# Public domain pointing to your server (DNS A record); Caddy gets the HTTPS certificate.
DOMAIN=rag.example.com
# Required in production. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVIDENCELAB_API_KEY=
